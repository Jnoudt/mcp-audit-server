# Local-only ReconFlow demo persistence. Set RECONFLOW_LOCAL_DEMO=true only for local development.
RECONFLOW_LOCAL_DEMO=true
RECONFLOW_LOCAL_DB_PATH=.local/reconflow-demo.sqlite3
RECONFLOW_LOCAL_STORAGE_DIR=.local/uploads

# AI is disabled by default. These values must refer to an existing Foundry deployment.
# No model is deployed or called by default; each UI request also requires explicit consent.
RECONFLOW_AI_ENABLED=false
FOUNDRY_OPENAI_BASE_URL=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_REASONING_EFFORT=
FOUNDRY_API_KEY=

# Optional frontend override for a deployed API:
# VITE_API_BASE_URL=https://reconflow-api-ep8odn.azurewebsites.net
